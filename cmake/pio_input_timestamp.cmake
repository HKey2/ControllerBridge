# Capture receive timestamps for normal input scheduling without changing the
# pinned vendor source. The hook runs after the packet/handshake has finished.
file(READ "${CMAKE_SOURCE_DIR}/third_party/Pico-PIO-USB/src/pio_usb_host.c" _pio_host)
set(_input_point "  uint8_t const receive_pid = pp->usb_rx_buffer[1];\n")
string(FIND "${_pio_host}" "${_input_point}" _input_offset)
if(_input_offset EQUAL -1)
    message(FATAL_ERROR "Pinned PIO USB receive point changed")
endif()
string(REPLACE "${_input_point}" "${_input_point}  extern void uc_pio_input_complete(uint8_t, uint8_t, uint8_t, int, uint8_t);\n  uc_pio_input_complete(ep->dev_addr, ep->ep_num, receive_pid, receive_len, expect_pid);\n" _pio_timestamped "${_pio_host}")
# Build a second scheduler only for the feedback-enabled route. Its input
# transaction order is identical, but its owned OUT pipe runs in idle time.
string(FIND "${_pio_timestamped}" "void __not_in_flash_func(pio_usb_host_frame)(void) {" _frame_start)
string(FIND "${_pio_timestamped}" "static bool __no_inline_not_in_flash_func(sof_timer)" _frame_end)
if(_frame_start LESS 0 OR _frame_end LESS _frame_start)
    message(FATAL_ERROR "Pinned PIO frame scheduler changed")
endif()
math(EXPR _frame_length "${_frame_end}-${_frame_start}")
string(SUBSTRING "${_pio_timestamped}" ${_frame_start} ${_frame_length} _feedback_frame)
string(REPLACE "pio_usb_host_frame" "uc_pio_feedback_frame" _feedback_frame "${_feedback_frame}")
set(_feedback_point "        if (ep->has_transfer && !ep->transfer_aborted) {\n")
string(FIND "${_feedback_frame}" "${_feedback_point}" _feedback_offset)
if(_feedback_offset LESS 0)
    message(FATAL_ERROR "Pinned PIO endpoint service changed")
endif()
string(REPLACE "${_feedback_point}" "        extern uint8_t uc_feedback_endpoint;\n        if(ep->dev_addr==1 && (uc_feedback_endpoint==0x80?!(ep->ep_num&127):ep->ep_num==uc_feedback_endpoint))continue;\n${_feedback_point}" _feedback_frame "${_feedback_frame}")
file(READ "${CMAKE_SOURCE_DIR}/lib/controller_usb/feedback_pio.inc" _feedback_tail)
string(APPEND _pio_timestamped "\n${_feedback_frame}\n${_feedback_tail}")
set(_input_file "${CMAKE_BINARY_DIR}/generated/pio_usb_host_timestamped.c")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
file(CONFIGURE OUTPUT "${_input_file}" CONTENT "${_pio_timestamped}" @ONLY)
get_target_property(_pio_sources pico_pio_usb INTERFACE_SOURCES)
list(REMOVE_ITEM _pio_sources "${CMAKE_SOURCE_DIR}/third_party/Pico-PIO-USB/src/pio_usb_host.c")
set_property(TARGET pico_pio_usb PROPERTY INTERFACE_SOURCES "${_pio_sources};${_input_file}")
